@model SGA_Smash.Models.ViewModels.EditarPlanillaEmpleadoViewModel

@{
    ViewData["Title"] = "Editar deducciones y bonificaciones";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card rounded-3 mt-3">
                <div class="card-body">
                    <h3 class="mb-3">Editar deducciones y bonificaciones</h3>

                    <div class="mb-3">
                        <label class="form-label">Empleado</label>
                        <input class="form-control" value="@Model.Nombre" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Salario base</label>
                        <input class="form-control"
                               value="@(Model.SalarioBase.HasValue ? $"₡{Model.SalarioBase.Value:N0}" : "Sin salario")"
                               disabled />
                    </div>

                    <form asp-action="EditarPlanilla" method="post">
                        <input type="hidden" asp-for="EmpleadoId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DeduccionesFijas" class="form-label"></label>
                                <input asp-for="DeduccionesFijas" class="form-control" />
                                <span asp-validation-for="DeduccionesFijas" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BonificacionesFijas" class="form-label"></label>
                                <input asp-for="BonificacionesFijas" class="form-control" />
                                <span asp-validation-for="BonificacionesFijas" class="text-danger"></span>
                            </div>
                        </div>

                        <p class="text-muted">
                            Estos valores se usarán como <strong>deducciones</strong> y
                            <strong>bonificaciones</strong> por defecto en las próximas planillas del empleado.
                        </p>

                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
