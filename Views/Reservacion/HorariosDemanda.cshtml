@model IEnumerable<SGA_Smash.Models.HorarioDemanda>

@{
    ViewData["Title"] = "Horarios con Más Demanda";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card rounded-3">
                <div class="card-body">
                    <div class="d-md-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="card-title">
                                <i class="ti ti-chart-bar me-2"></i>Horarios con Más Demanda
                            </h4>
                            <p class="card-subtitle text-muted">Análisis de horarios con mayor cantidad de reservaciones confirmadas</p>
                        </div>
                        <div>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="ti ti-arrow-left me-1"></i> Volver a Reservaciones
                            </a>
                        </div>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="ti ti-alert-circle me-2"></i>@TempData["Error"]
                        </div>
                    }
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info">
                            <i class="ti ti-info-circle me-2"></i>@TempData["Info"]
                        </div>
                    }

                    <!-- Filtros -->
                    <div class="card mt-3 border-info">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="ti ti-filter me-2"></i>Filtros de Búsqueda
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="HorariosDemanda" method="get" class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Fecha Desde <span class="text-muted">(Opcional)</span></label>
                                    <input type="date" name="desde" class="form-control" value="@ViewBag.Desde?.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Fecha Hasta <span class="text-muted">(Opcional)</span></label>
                                    <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta?.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Cantidad de Resultados</label>
                                    <input type="number" name="top" class="form-control" value="@ViewBag.Top" min="1" max="50" placeholder="Ej: 10" />
                                    <small class="text-muted">Máximo 50 resultados</small>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">&nbsp;</label>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="ti ti-search me-1"></i> Buscar
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="table-responsive mt-4">
                        <table class="table mb-0 text-nowrap varient-table align-middle fs-3">
                            <thead>
                                <tr>
                                    <th class="px-0 text-muted">#</th>
                                    <th class="px-0 text-muted">Hora</th>
                                    <th class="px-0 text-muted">Cantidad de Reservaciones</th>
                                    <th class="px-0 text-muted">Porcentaje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var horariosList = Model.ToList();
                                    var totalReservaciones = horariosList.Sum(h => h.CantidadReservaciones);
                                    int index = 1;
                                }
                                @foreach (var horario in horariosList)
                                {
                                    var porcentaje = totalReservaciones > 0 ? (horario.CantidadReservaciones * 100.0 / totalReservaciones) : 0;
                                    
                                    <tr>
                                        <td class="px-0">@index</td>
                                        <td class="px-0">
                                            <strong>@horario.HoraFormato</strong>
                                        </td>
                                        <td class="px-0">
                                            <span class="badge bg-primary">@horario.CantidadReservaciones</span>
                                        </td>
                                        <td class="px-0">
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" role="progressbar" 
                                                     style="width: @porcentaje.ToString("F1")%" 
                                                     aria-valuenow="@porcentaje" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                    @porcentaje.ToString("F1")%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    index++;
                                }
                                @if (!horariosList.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            No se encontraron reservaciones confirmadas en el rango de fechas especificado.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (horariosList.Any())
                    {
                        <div class="mt-3">
                            <p class="text-muted">
                                <strong>Total de reservaciones analizadas:</strong> @totalReservaciones
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

