@model SGA_Smash.Models.Reservacion

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card rounded-3">
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-warning">
                            <strong>Errores de validación:</strong>
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    <h4 class="card-title">Agregar Reservación</h4>
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Cliente -->
                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label">Cliente</label>
                            <select asp-for="ClienteId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Clientes, "Id", "Nombre"))">
                                <option value="">-- Selecciona Cliente --</option>
                            </select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>



                        <!-- Fecha y hora -->
                        <div class="mb-3">
                            <label asp-for="FechaHora" class="form-label">Fecha y Hora</label>
                            <input asp-for="FechaHora" type="datetime-local" class="form-control" />
                            <span asp-validation-for="FechaHora" class="text-danger"></span>
                        </div>

                        <!-- Mesa -->
                        <div class="mb-3">
                            <label asp-for="Mesa" class="form-label">Mesa</label>
                            <select asp-for="Mesa" class="form-select" id="mesaSelect">
                                <option value="">-- Selecciona una mesa --</option>
                            </select>
                            <span asp-validation-for="Mesa" class="text-danger"></span>
                            <small class="form-text text-muted" id="mesaInfo">Selecciona una fecha y hora para ver las mesas disponibles</small>
                        </div>

                        <!-- Número de Personas -->    
                        <div class="mb-3">
                            <label asp-for="NumeroPersonas" class="form-label">Número de Personas</label>
                            <input asp-for="NumeroPersonas" type="number" min="1" max="20" class="form-control" />
                            <span asp-validation-for="NumeroPersonas" class="text-danger"></span>
                        </div>


                        <!-- Estado -->
                        <div class="mb-3">
                            <label asp-for="Estado" class="form-label">Estado</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="Confirmada">Confirmada</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Cancelada">Cancelada</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <!-- Botones -->
                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">Guardar</button>
                            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            const fechaHoraInput = $('#FechaHora');
            const numeroPersonasInput = $('#NumeroPersonas');
            const mesaSelect = $('#mesaSelect');
            const mesaInfo = $('#mesaInfo');

            // Función para cargar mesas disponibles
            function cargarMesasDisponibles() {
                const fechaHora = fechaHoraInput.val();
                const numeroPersonas = parseInt(numeroPersonasInput.val()) || 0;
                
                if (!fechaHora) {
                    mesaSelect.html('<option value="">-- Selecciona una fecha y hora primero --</option>');
                    mesaInfo.text('Selecciona una fecha y hora para ver las mesas disponibles');
                    return;
                }

                if (!numeroPersonas || numeroPersonas < 1) {
                    mesaSelect.html('<option value="">-- Ingresa el número de personas primero --</option>');
                    mesaInfo.text('Ingresa el número de personas para ver las mesas disponibles');
                    return;
                }

                // Convertir la fecha/hora local a formato para la API
                const fechaHoraObj = new Date(fechaHora);
                const fechaHoraISO = fechaHoraObj.toISOString();

                mesaInfo.text('Cargando mesas disponibles...');
                mesaSelect.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("GetMesasDisponibles", "Reservacion")',
                    type: 'GET',
                    data: { 
                        fechaHora: fechaHoraISO,
                        numeroPersonas: numeroPersonas
                    },
                    success: function(mesas) {
                        mesaSelect.html('<option value="">-- Selecciona una mesa --</option>');
                        
                        if (mesas && mesas.length > 0) {
                            mesas.forEach(function(mesa) {
                                const optionText = mesa.numero + ' (Capacidad: ' + mesa.capacidad + ' personas)';
                                mesaSelect.append($('<option></option>').val(mesa.numero).text(optionText));
                            });
                            mesaInfo.text(mesas.length + ' mesa(s) disponible(s) para ' + numeroPersonas + ' persona(s)');
                        } else {
                            mesaSelect.html('<option value="">-- No hay mesas disponibles --</option>');
                            mesaInfo.text('No hay mesas disponibles para ' + numeroPersonas + ' persona(s) en esta fecha y hora');
                        }
                        
                        mesaSelect.prop('disabled', false);
                    },
                    error: function() {
                        mesaSelect.html('<option value="">-- Error al cargar mesas --</option>');
                        mesaInfo.text('Error al cargar las mesas disponibles');
                        mesaSelect.prop('disabled', false);
                    }
                });
            }

            // Cargar mesas cuando cambie la fecha/hora o el número de personas
            fechaHoraInput.on('change', cargarMesasDisponibles);
            numeroPersonasInput.on('change', cargarMesasDisponibles);
        });
    </script>
}
