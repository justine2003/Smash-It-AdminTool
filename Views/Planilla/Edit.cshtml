@model SGA_Smash.Models.Planilla
@using System.Globalization

@{
    ViewData["Title"] = "Editar planilla";
    var esCR = new CultureInfo("es-CR");
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card rounded-3 mt-3">
                <div class="card-body">
                    <h3 class="mb-4">Editar planilla</h3>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EmpleadoId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Empleado (solo lectura) -->
                        <div class="mb-3">
                            <label class="form-label">Empleado</label>
                            <input class="form-control"
                                   value="@(Model.Empleado?.Nombre ?? $"Empleado #{Model.EmpleadoId}")"
                                   disabled />
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Mes" class="form-label"></label>
                                <input asp-for="Mes" class="form-control" type="number" min="1" max="12" />
                                <span asp-validation-for="Mes" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Anio" class="form-label"></label>
                                <input asp-for="Anio" class="form-control" type="number" min="2000" max="2100" />
                                <span asp-validation-for="Anio" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SalarioBase" class="form-label"></label>
                                <input asp-for="SalarioBase" class="form-control" />
                                <span asp-validation-for="SalarioBase" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Bonificaciones" class="form-label"></label>
                                <input asp-for="Bonificaciones" class="form-control" />
                                <span asp-validation-for="Bonificaciones" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Deducciones" class="form-label"></label>
                                <input asp-for="Deducciones" class="form-control" />
                                <span asp-validation-for="Deducciones" class="text-danger"></span>
                            </div>
                        </div>

                        <p class="text-muted">
                            El salario neto se recalculará como:
                            <strong>Salario base + Bonificaciones - Deducciones</strong>.
                        </p>

                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
