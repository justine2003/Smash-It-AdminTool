@using SGA_Smash.Models
@{
    ViewData["Title"] = "Nueva planilla";
    var empleados = ViewBag.Empleados as List<Empleado>;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card rounded-3">
                <div class="card-body">
                    <h3 class="mb-3">Nueva planilla</h3>

                    @* Si no hay empleados activos, mostramos mensaje *@
                    @if (empleados == null || !empleados.Any())
                    {
                        <div class="alert alert-warning">
                            No hay empleados activos registrados. Debe registrar al menos un empleado activo
                            antes de crear una planilla.
                        </div>
                    }
                    else
                    {
                        <form asp-action="Create" asp-controller="Planilla" method="post" class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">Empleado</label>
                                <select name="empleadoId" class="form-select" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var e in empleados)
                                    {
                                        <option value="@e.Id">@e.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Mes</label>
                                <input type="number"
                                       name="mes"
                                       class="form-control"
                                       min="1"
                                       max="12"
                                       required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Año</label>
                                <input type="number"
                                       name="anio"
                                       class="form-control"
                                       min="2000"
                                       max="2100"
                                       required />
                            </div>

                            <div class="col-12">
                                <p class="text-muted mb-0">
                                    El salario base, las bonificaciones y las deducciones se tomarán de los datos
                                    del empleado (salario base, bonificaciones fijas y deducciones fijas).
                                    El salario neto se calculará automáticamente.
                                </p>
                            </div>

                            <div class="col-12 mt-3">
                                <button type="submit" class="btn btn-primary">Guardar planilla</button>
                                <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>