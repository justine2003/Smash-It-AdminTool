@model SGA_Smash.Models.Planilla
@{
    ViewData["Title"] = "Eliminar Planilla";
}
<div class="container-fluid">
  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h3 class="mb-0 text-danger">Eliminar Planilla</h3>
      <a asp-action="Index" class="btn btn-secondary btn-sm">Volver</a>
    </div>
  </div>

  <div class="card border-danger rounded-3"><div class="card-body">
    <dl class="row">
      <dt class="col-sm-3">Empleado</dt>
      <dd class="col-sm-9">@((Model.Empleado?.Nombre) ?? $"Empleado #{Model.EmpleadoId}")</dd>
      <dt class="col-sm-3">Mes/Año</dt>
      <dd class="col-sm-9">@Model.Mes/@Model.Anio</dd>
      <dt class="col-sm-3">Salario Neto</dt>
      <dd class="col-sm-9">₡@Model.SalarioNeto:N0</dd>
    </dl>

    <form asp-action="Delete" method="post">
      <input type="hidden" asp-for="Id" />
      <button class="btn btn-danger"><i class="ti ti-trash"></i> Eliminar</button>
      <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
    </form>
  </div></div>
</div>