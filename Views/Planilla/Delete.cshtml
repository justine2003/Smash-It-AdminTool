@model SGA_Smash.Models.Planilla
@using System.Globalization

@{
    ViewData["Title"] = "Eliminar planilla";
    var esCR = new CultureInfo("es-CR");
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card rounded-3 mt-3">
                <div class="card-body">
                    <h3 class="mb-4">Eliminar planilla</h3>

                    <p class="text-muted">
                        ¿Seguro que deseas eliminar esta planilla? Esta acción no se puede deshacer.
                    </p>

                    <dl class="row">
                        <dt class="col-sm-3">Empleado</dt>
                        <dd class="col-sm-9">
                            @(Model.Empleado?.Nombre ?? $"Empleado #{Model.EmpleadoId}")
                        </dd>

                        <dt class="col-sm-3">Periodo</dt>
                        <dd class="col-sm-9">
                            @($"{Model.Mes:D2}/{Model.Anio}")
                        </dd>

                        <dt class="col-sm-3">Salario base</dt>
                        <dd class="col-sm-9">
                            @($"₡{Model.SalarioBase.ToString("N0", esCR)}")
                        </dd>

                        <dt class="col-sm-3">Bonificaciones</dt>
                        <dd class="col-sm-9">
                            @($"₡{Model.Bonificaciones.ToString("N0", esCR)}")
                        </dd>

                        <dt class="col-sm-3">Deducciones</dt>
                        <dd class="col-sm-9">
                            @($"₡{Model.Deducciones.ToString("N0", esCR)}")
                        </dd>

                        <dt class="col-sm-3">Salario neto</dt>
                        <dd class="col-sm-9 fw-semibold">
                            @($"₡{Model.SalarioNeto.ToString("N0", esCR)}")
                        </dd>

                        <dt class="col-sm-3">Fecha de registro</dt>
                        <dd class="col-sm-9">
                            @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash"></i> Eliminar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            Cancelar
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
