@model IEnumerable<SGA_Smash.Models.Vacacion>
@{
    ViewData["Title"] = "Solicitudes Pendientes";
}
<div class="container-fluid">
  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h3 class="mb-0">Solicitudes Pendientes</h3>
    </div>
  </div>

  @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

  <div class="card rounded-3"><div class="card-body">
    @if (Model == null || !Model.Any())
    {
      <div class="text-center text-muted py-5">No hay solicitudes pendientes.</div>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Empleado</th>
              <th>Periodo</th>
              <th>Días</th>
              <th>Fecha Solicitud</th>
              <th class="text-center" style="width: 200px;">Acciones</th>
            </tr>
          </thead>
          <tbody>
          @foreach (var v in Model)
          {
            <tr>
              <td>@(v.Empleado?.Nombre ?? $"Empleado #{v.EmpleadoId}")</td>
              <td>@v.FechaInicio.ToString("dd/MM/yyyy") - @v.FechaFin.ToString("dd/MM/yyyy")</td>
              <td>@v.DiasSolicitados</td>
              <td>@v.FechaSolicitud.ToString("dd/MM/yyyy")</td>
              <td class="text-center">
                <form asp-action="Aprobar" method="post" class="d-inline">
                  <input type="hidden" name="id" value="@v.Id" />
                  <button class="btn btn-success btn-sm"><i class="ti ti-check"></i> Aprobar</button>
                </form>
                <form asp-action="Rechazar" method="post" class="d-inline ms-2">
                  <input type="hidden" name="id" value="@v.Id" />
                  <button class="btn btn-danger btn-sm"><i class="ti ti-x"></i> Rechazar</button>
                </form>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div></div>
</div>
