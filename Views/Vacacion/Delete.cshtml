@model SGA_Smash.Models.Vacacion
@{
    ViewData["Title"] = "Eliminar Solicitud de Vacaciones";
}
<div class="container-fluid">
  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h3 class="mb-0 text-danger">Eliminar Solicitud</h3>
      <a asp-action="Index" class="btn btn-secondary btn-sm">Volver</a>
    </div>
  </div>

  <div class="card border-danger rounded-3"><div class="card-body">
    <p>¿Confirma eliminar esta solicitud?</p>
    <dl class="row">
      <dt class="col-sm-3">Empleado</dt>
      <dd class="col-sm-9">@((Model.Empleado?.Nombre) ?? $"Empleado #{Model.EmpleadoId}")</dd>

      <dt class="col-sm-3">Periodo</dt>
      <dd class="col-sm-9">@Model.FechaInicio:dd/MM/yyyy - @Model.FechaFin:dd/MM/yyyy</dd>

      <dt class="col-sm-3">Días</dt>
      <dd class="col-sm-9">@Model.DiasSolicitados</dd>

      <dt class="col-sm-3">Estado</dt>
      <dd class="col-sm-9">@Model.Estado</dd>
    </dl>

    <form asp-action="Delete" method="post">
      <input type="hidden" asp-for="Id" />
      <button class="btn btn-danger"><i class="ti ti-trash"></i> Eliminar</button>
      <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
    </form>
  </div></div>
</div>
