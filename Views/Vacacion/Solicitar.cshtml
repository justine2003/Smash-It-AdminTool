@model SGA_Smash.Models.Vacacion
@{
    ViewData["Title"] = "Solicitar vacaciones";
    var disponibles = (int)(ViewBag.Disponibles ?? 0);
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="container-fluid">
  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h3 class="mb-0">Solicitar vacaciones</h3>
      <a asp-action="MisSolicitudes" class="btn btn-secondary">Mis solicitudes</a>
    </div>
  </div>

  <div class="alert alert-info">
    Días disponibles: <strong>@disponibles</strong>
  </div>

  <div class="card rounded-3">
    <div class="card-body">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>
      <form asp-action="Solicitar" method="post" novalidate>
        <input type="hidden" asp-for="EmpleadoId" />
        <div class="row g-3">
          <div class="col-md-4">
            <label asp-for="FechaInicio" class="form-label">Fecha inicio</label>
            <input asp-for="FechaInicio" type="date" class="form-control" id="FechaInicio" min="@hoy" />
            <span asp-validation-for="FechaInicio" class="text-danger"></span>
          </div>
          <div class="col-md-4">
            <label asp-for="FechaFin" class="form-label">Fecha fin</label>
            <input asp-for="FechaFin" type="date" class="form-control" id="FechaFin" min="@hoy" />
            <span asp-validation-for="FechaFin" class="text-danger"></span>
          </div>
          <div class="col-md-4">
            <label class="form-label">Días solicitados</label>
            <input id="dias" class="form-control" value="@Model.DiasCalculados" readonly />
          </div>
        </div>

        <div class="mt-4">
          <button id="btnEnviar" class="btn btn-primary"><i class="ti ti-send me-1"></i> Enviar solicitud</button>
          <a asp-action="MisSolicitudes" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    const disp = @disponibles;
    const fi = document.getElementById("FechaInicio");
    const ff = document.getElementById("FechaFin");
    const d  = document.getElementById("dias");
    const btn= document.getElementById("btnEnviar");

    function calc() {
      if (!fi.value || !ff.value) { d.value = ""; btn.disabled = false; return; }
      const a = new Date(fi.value);
      const b = new Date(ff.value);
      const ms = (b - a);
      const days = Math.floor(ms / (1000*60*60*24)) + 1;
      d.value = isNaN(days) ? "" : days;

      // bloqueo cliente si excede disponibles o si fin < inicio
      const ok = !isNaN(days) && days > 0 && days <= disp && b >= a;
      btn.disabled = !ok;
    }

    fi?.addEventListener("change", calc);
    ff?.addEventListener("change", calc);
    calc();
  </script>
}
