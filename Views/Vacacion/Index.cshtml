@model IEnumerable<SGA_Smash.Models.Vacacion>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Solicitudes de Vacaciones (Admin)";
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;

    // Filtros actuales (si vienen del controlador por ViewData o Query)
    int? empleadoId = ViewBag.EmpleadoId as int?;
    string estado = ViewBag.Estado as string ?? "";
    DateTime? desde = ViewBag.Desde as DateTime?;
    DateTime? hasta = ViewBag.Hasta as DateTime?;
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Solicitudes de Vacaciones (Admin)</h3>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card rounded-3 mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Empleado</label>
                    @* Espera ViewBag.Empleados = new SelectList(empleados, "Id","Nombre", empleadoId) *@
                    <select name="empleadoId" class="form-select">
                        <option value="">-- Todos --</option>
                        @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Empleados ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@item.Value" selected="@(empleadoId.HasValue && item.Value == empleadoId.Value.ToString() ? "selected" : null)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="" selected="@string.IsNullOrEmpty(estado)">-- Todos --</option>
                        <option value="Pendiente" selected="@(estado=="Pendiente")">Pendiente</option>
                        <option value="Aprobada" selected="@(estado=="Aprobada")">Aprobada</option>
                        <option value="Rechazada" selected="@(estado=="Rechazada")">Rechazada</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" name="desde" class="form-control" value="@(desde.HasValue ? desde.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" name="hasta" class="form-control" value="@(hasta.HasValue ? hasta.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">
                        <i class="ti ti-filter me-1"></i> Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card rounded-3">
            <div class="card-body text-center py-5">
                <h5 class="mb-2">No hay solicitudes con los criterios seleccionados</h5>
            </div>
        </div>
    }
    else
    {
        <div class="card rounded-3">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Empleado</th>
                                <th>Período</th>
                                <th class="text-center">Días</th>
                                <th>Estado</th>
                                <th>Fecha Solicitud</th>
                                <th>Comentario admin</th>
                                <th class="text-end" style="width:280px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="text-secondary">
                        @foreach (var v in Model)
                        {
                            var badge = v.Estado == "Aprobada" ? "bg-success"
                                       : v.Estado == "Rechazada" ? "bg-danger"
                                       : "bg-warning text-dark";
                            <tr>
                                <td>@(v.Empleado?.Nombre ?? $"Empleado #{v.EmpleadoId}")</td>
                                <td>@v.FechaInicio.ToString("dd/MM/yyyy") - @v.FechaFin.ToString("dd/MM/yyyy")</td>
                                <td class="text-center fw-semibold">@v.DiasSolicitados</td>
                                <td><span class="badge @badge">@v.Estado</span></td>
                                <td>@v.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(v.ComentarioAdmin) ? "-" : v.ComentarioAdmin)</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2 flex-wrap justify-content-end">

                                        <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="ti ti-eye"></i> Ver
                                        </a>

                                        @if (v.Estado == "Pendiente")
                                        {
                                            <!-- Aprobar con comentario -->
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-sm btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="ti ti-check"></i> Aprobar
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 280px;">
                                                    <form asp-action="Aprobar" asp-route-id="@v.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="mb-2">
                                                            <label class="form-label">Comentario (opcional)</label>
                                                            <textarea name="comentario" class="form-control" rows="2" placeholder="Aprobada..."></textarea>
                                                        </div>
                                                        <button class="btn btn-success btn-sm w-100" onclick="return confirm('¿Aprobar la solicitud?');">
                                                            Confirmar aprobación
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>

                                            <!-- Rechazar con comentario -->
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-sm btn-danger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="ti ti-x"></i> Rechazar
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 280px;">
                                                    <form asp-action="Rechazar" asp-route-id="@v.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="mb-2">
                                                            <label class="form-label">Motivo del rechazo</label>
                                                            <textarea name="comentario" class="form-control" rows="2" placeholder="Motivo..."></textarea>
                                                        </div>
                                                        <button class="btn btn-danger btn-sm w-100" onclick="return confirm('¿Rechazar la solicitud?');">
                                                            Confirmar rechazo
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>

                                            <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-warning">
                                                <i class="ti ti-pencil"></i> Editar
                                            </a>
                                        }

                                        <a asp-action="Delete" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="ti ti-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
