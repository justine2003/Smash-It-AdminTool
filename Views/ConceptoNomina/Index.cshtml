@model IEnumerable<SGA_Smash.Models.ConceptoNomina>
@{
    ViewData["Title"] = "Conceptos de Nómina Activos";
    var empleadoId = (int)ViewBag.EmpleadoId;
}
<div class="container-fluid">
  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h3 class="mb-0">Conceptos Activos — Empleado #@empleadoId</h3>
    </div>
  </div>

  @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
  @if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div> }

  <div class="card rounded-3">
    <div class="card-body">
      @if (Model == null || !Model.Any())
      {
        <div class="text-center text-muted py-5">No hay conceptos activos.</div>
      }
      else
      {
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th class="text-end">Monto</th>
                <th class="text-center" style="width: 140px;">Acciones</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var c in Model)
              {
                <tr>
                  <td>@c.Nombre</td>
                  <td>@(c.Tipo == 'D' ? "Deducción" : "Bonificación")</td>
                  <td class="text-end">@c.Monto.ToString("N2")</td>
                  <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@c.Id" asp-route-empleadoId="@empleadoId"
                       class="btn btn-warning btn-sm">
                      <i class="ti ti-pencil"></i> Editar
                    </a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </div>
</div>
