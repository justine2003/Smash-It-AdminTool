@model SGA_Smash.Models.ConceptoNomina
@{
    ViewData["Title"] = "Editar Concepto de Nómina";
    var empleadoId = (int)ViewBag.EmpleadoId;
}
<div class="container-fluid">
  <div class="row"><div class="col-12">
    <div class="card rounded-3"><div class="card-body">
      <h4 class="card-title">Editar Concepto</h4>

      <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="empleadoId" value="@empleadoId" />

        <div class="mb-3">
          <label class="form-label">Empleado</label>
          <input class="form-control" value="@empleadoId" readonly />
        </div>

        <div class="mb-3">
          <label asp-for="Nombre" class="form-label"></label>
          <input asp-for="Nombre" class="form-control" readonly />
        </div>

        <div class="mb-3">
          <label asp-for="Tipo" class="form-label"></label>
          <input class="form-control" value="@(Model.Tipo == 'D' ? "Deducción" : "Bonificación")" readonly />
          <input type="hidden" asp-for="Tipo" />
        </div>

        <div class="mb-3">
          <label asp-for="Monto" class="form-label">Monto</label>
          <input asp-for="Monto" type="number" min="0" step="0.01" class="form-control" required />
          <span asp-validation-for="Monto" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Activo" class="form-label">Activo</label><br />
          <input asp-for="Activo" class="form-check-input" type="checkbox" disabled />
          <input type="hidden" asp-for="Activo" />
        </div>

        <button type="submit" class="btn btn-primary">
          <i class="ti ti-check me-1"></i> Guardar
        </button>
        <a asp-action="Index" asp-route-empleadoId="@empleadoId" class="btn btn-secondary ms-2">Cancelar</a>
      </form>

      @if (TempData["Error"] != null)
      {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
      }
    </div></div>
  </div></div>
</div>

@section Scripts{
  <partial name="_ValidationScriptsPartial" />
}
