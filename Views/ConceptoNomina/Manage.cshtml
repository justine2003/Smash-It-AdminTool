@model IEnumerable<SGA_Smash.Models.ConceptoNomina>
@{
  var emp = ViewBag.Empleado as SGA_Smash.Models.Empleado;
  ViewData["Title"] = $"Conceptos de {emp?.Nombre ?? ("Empleado #" + emp?.Id)}";
}
<div class="container-fluid">

  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h3 class="mb-0">Conceptos de Nómina — @emp?.Nombre</h3>
      <a asp-controller="Planilla" asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
  </div>

  @if (TempData["Success"] != null)
  { <div class="alert alert-success">@TempData["Success"]</div> }
  @if (TempData["Error"] != null)
  { <div class="alert alert-danger">@TempData["Error"]</div> }

  <div class="card mb-3">
    <div class="card-body">
      <form asp-action="Create" method="post" class="row g-2 align-items-end">
        <input type="hidden" name="empleadoId" value="@emp?.Id" />
        <div class="col-md-2">
          <label class="form-label">Tipo</label>
          <select name="tipo" class="form-select">
            <option>Deduccion</option>
            <option>Bonificacion</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Nombre</label>
          <input name="nombre" class="form-control" required />
        </div>
        <div class="col-md-3">
          <label class="form-label">Monto</label>
          <input name="monto" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="col-md-2">
          <label class="form-label">Activo</label>
          <select name="activo" class="form-select">
            <option value="true">Sí</option>
            <option value="false">No</option>
          </select>
        </div>
        <div class="col-md-1">
          <button class="btn btn-primary w-100"><i class="ti ti-plus"></i></button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Tipo</th>
              <th>Nombre</th>
              <th>Monto</th>
              <th>Activo</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody class="text-secondary">
          @foreach (var c in Model)
          {
            <tr>
              <td>@c.Tipo</td>
              <td>@c.Nombre</td>
              <td>₡@c.Monto:N0</td>
              <td>@(c.Activo ? "Sí" : "No")</td>
              <td class="text-end">
                <form asp-action="Update" method="post" class="d-inline-block me-2">
                  <input type="hidden" name="id" value="@c.Id" />
                  <input type="number" step="0.01" name="monto" value="@c.Monto" class="form-control form-control-sm d-inline" style="max-width:140px" />
                  <select name="activo" class="form-select form-select-sm d-inline" style="max-width:120px">
                    <option value="true" selected="@(c.Activo)">Sí</option>
                    <option value="false" selected="@(!c.Activo)">No</option>
                  </select>
                  <button class="btn btn-sm btn-success ms-1"><i class="ti ti-check"></i></button>
                </form>

                <form asp-action="Toggle" method="post" class="d-inline-block me-2">
                  <input type="hidden" name="id" value="@c.Id" />
                  <button class="btn btn-sm btn-warning"><i class="ti ti-switch-2"></i></button>
                </form>

                <form asp-action="Delete" method="post" class="d-inline-block" onsubmit="return confirm('¿Eliminar concepto?');">
                  <input type="hidden" name="id" value="@c.Id" />
                  <button class="btn btn-sm btn-danger"><i class="ti ti-trash"></i></button>
                </form>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
