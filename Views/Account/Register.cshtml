@model SGA_Smash.Models.Usuario

@{
    Layout = null; // o usa tu _Layout si quieres el menú
}

<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registrar Usuario - SGA Smash</title>

    <link rel="shortcut icon" href="~/assets/images/logos/smashlogo.svg" />
    <link rel="stylesheet" href="~/assets/css/styles.min.css" />

    <style>
        body {
            position: relative;
            background-image: url('/assets/images/backgrounds/hamburguer.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.5);
            z-index: 0;
        }

        .page-wrapper {
            position: relative;
            z-index: 1;
        }

        .glass-card {
            background-color: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .btn-smash-red {
            background-color: #FF2E2E;
            color: white;
        }

        .btn-smash-red:hover {
            background-color: #e62828;
            color: white;
        }
    </style>
</head>
<body>
    <div class="page-wrapper" id="main-wrapper">
        <div class="position-relative min-vh-100 d-flex align-items-center justify-content-center">
            <div class="row justify-content-center w-100 px-3">
                <div class="col-md-8 col-lg-6 col-xxl-3">
                    <div class="card glass-card mb-0">
                        <div class="card-body">
                            <a href="~/Home/Index" class="text-nowrap logo-img text-center d-block py-3 w-100">
                                <img src="~/assets/images/logos/smashlogo.svg" width="150" alt="logo" />
                            </a>
                            <p class="text-center text-white">Registrar nuevo usuario</p>

                            <form asp-action="Register" asp-controller="Account" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <div class="mb-3">
                                    <label asp-for="nombre" class="form-label text-white"></label>
                                    <input asp-for="nombre" class="form-control" />
                                    <span asp-validation-for="nombre" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="correo" class="form-label text-white"></label>
                                    <input asp-for="correo" class="form-control" />
                                    <span asp-validation-for="correo" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="contrasena" class="form-label text-white"></label>
                                    <input asp-for="contrasena" type="password" class="form-control" />
                                    <span asp-validation-for="contrasena" class="text-danger"></span>
                                </div>

                                @* Si quieres setear el rol fijo, puedes usar un hidden:
                                   <input type="hidden" asp-for="rol_id" value="2" />
                                *@

                                <button type="submit"
                                        class="btn btn-smash-red w-100 py-8 fs-4 mb-2 rounded-2">
                                    Guardar usuario
                                </button>

                                <a asp-action="Login" asp-controller="Account"
                                   class="btn btn-outline-light w-100 rounded-2">
                                    Volver al inicio de sesión
                                </a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
